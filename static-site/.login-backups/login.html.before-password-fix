<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>UMBC Stormwater GIS — Sign In</title>
  <link rel="stylesheet" href="login.css">
</head>
<body>
  <main class="login-page">
    <section class="login-card" aria-labelledby="sign-in-title">
      <header class="login-header">
        <div class="logo-box">
          <img src="assets/stormwater-logo.png" alt="UMBC Stormwater GIS logo" width="52" height="52">
        </div>
        <div>
          <h1>UMBC</h1>
          <p>STORMWATER GIS</p>
        </div>
      </header>

      <div class="login-content">
        <h2 id="sign-in-title">Sign in</h2>
        <p class="subtitle">Access the campus stormwater map and BMP inspection workspace using your authorized UMBC ArcGIS account.</p>

        <form id="login-form" novalidate>
          <label for="email">UMBC email</label>
          <input
            id="email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="username"
            placeholder="username@umbc.edu"
            spellcheck="false"
            required
          >
          <label class="password-label" for="password">Password</label>
          <input
            id="password"
            type="password"
            placeholder="Enter any nonempty test password"
            autocomplete="off"
            spellcheck="false"
            required
          >
          <p class="input-hint">For this demo, any nonempty test password works. Do not enter your real UMBC password.</p>

          <p id="login-error" class="login-error" role="alert" aria-live="polite"></p>
          <button id="sign-in-button" type="submit">Sign in</button>
        </form>

        <p class="login-help">The demo password is checked only in this browser and immediately cleared. Your actual identity is verified separately by the official UMBC / ArcGIS sign-in. The dashboard remains hidden until ArcGIS authenticates.</p>
      </div>
    </section>
  </main>
  <script src="login.js" defer></script>
</body>
</html>
